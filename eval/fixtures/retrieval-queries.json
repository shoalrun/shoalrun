{
  "schemaVersion": 1,
  "site": "docs/docs.config.yaml",
  "note": "Labeled against the shoalrun docs. `expect` lists alternative pages; a hit on any counts. `expectGroups` marks synthesis questions that need a hit from every group of alternative pages. Kind `none` has no answer in the docs.",
  "queries": [
    { "kind": "exact", "query": "$include", "expect": ["guide.configuration", "reference.config"] },
    { "kind": "exact", "query": "outputs.html.search", "expect": ["guide.search", "guide.configuration"] },
    { "kind": "exact", "query": "shoalrun config explain", "expect": ["guide.configuration", "reference.cli"] },
    { "kind": "exact", "query": "Accept: text/markdown", "expect": ["guide.content-negotiation"] },
    { "kind": "exact", "query": "llms.txt", "expect": ["guide.agent-friendliness", "guide.content-negotiation", "guide.output"] },
    { "kind": "exact", "query": "subjectLifecycle", "expect": ["guide.frontmatter", "guide.frontmatter-reference", "guide.markdown-metadata"] },
    { "kind": "exact", "query": "ApiExample", "expect": ["guide.component.api-embeds"] },
    { "kind": "exact", "query": "ApiExample", "variant": "production|current|en", "readerSelection": { "focus": ["write"] }, "expect": ["guide.component.api-embeds"] },
    { "kind": "exact", "query": "site.basePath", "variant": "production|current|en", "readerSelection": { "focus": ["configure"] }, "expect": ["reference.config", "guide.content-negotiation"] },
    { "kind": "exact", "query": "shoalrun audit", "expect": ["guide.audit", "reference.cli"] },
    { "kind": "exact", "query": "deploy:check", "expect": ["guide.deployment-check"] },
    { "kind": "exact", "query": "readerFilters", "expect": ["guide.reader-filters"] },
    { "kind": "exact", "query": "site.origin", "expect": ["guide.seo", "reference.config", "guide.share-images", "guide.release-revisions"] },
    { "kind": "exact", "query": "site.header.links", "expect": ["guide.header", "guide.configuration"] },
    { "kind": "exact", "query": "access.policy", "expect": ["guide.frontmatter", "guide.frontmatter-reference", "guide.configuration", "guide.concepts"] },
    { "kind": "exact", "query": "shoalrun vercel build", "expect": ["guide.vercel", "reference.cli"] },
    { "kind": "exact", "query": "pathPrefix", "expect": ["reference.config", "reference.config-examples", "guide.publications"] },
    { "kind": "exact", "query": "frontmatter.enforced", "expect": ["guide.frontmatter", "guide.frontmatter-reference", "guide.custom-metadata", "guide.configuration"] },

    { "kind": "task", "query": "how do I deploy to Vercel", "expect": ["guide.vercel"] },
    { "kind": "task", "query": "create a new page from a template", "expect": ["guide.add-page", "guide.templates"] },
    { "kind": "task", "query": "is there a way to do code tutorials with Shoalrun", "expect": ["guide.component.walkthrough"] },
    { "kind": "task", "query": "change the site colors to match my brand", "expect": ["guide.palettes", "guide.themes", "guide.css"] },
    { "kind": "task", "query": "show different content in the Markdown version than the HTML page", "expect": ["guide.component.only"] },
    { "kind": "task", "query": "add an OpenAPI spec to my docs", "expect": ["guide.api-references", "guide.api-generation"] },
    { "kind": "task", "query": "reuse the same paragraph on several pages", "expect": ["guide.snippets"] },
    { "kind": "task", "query": "publish docs for more than one version", "expect": ["guide.publications", "guide.release-revisions"] },
    { "kind": "task", "query": "set the social preview image", "expect": ["guide.share-images", "guide.seo"] },
    { "kind": "task", "query": "make my docs easy for AI agents to read", "expect": ["guide.agent-friendliness", "guide.output", "guide.agent-skills"] },
    { "kind": "task", "query": "verify a deployed site is configured correctly", "expect": ["guide.deployment-check"] },
    { "kind": "task", "query": "let readers switch between views of the page", "expect": ["guide.reader-filters"] },
    { "kind": "task", "query": "build a landing page", "expect": ["guide.layouts"] },
    { "kind": "task", "query": "write a changelog", "expect": ["guide.release-notes"] },
    { "kind": "task", "query": "my page is marked as a draft and will not build", "expect": ["guide.troubleshooting", "guide.add-page"] },
    { "kind": "task", "query": "hide the search box", "expect": ["guide.search"] },
    { "kind": "task", "query": "make the site always use dark mode", "expect": ["guide.color-modes"] },
    { "kind": "task", "query": "use my own fonts", "expect": ["guide.themes"] },
    { "kind": "task", "query": "add a column of links to the footer", "expect": ["guide.footer"] },
    { "kind": "task", "query": "put a link to our GitHub repo in the masthead", "expect": ["guide.header"] },
    { "kind": "task", "query": "my page is not showing up in the built site", "expect": ["guide.troubleshooting"] },
    { "kind": "task", "query": "two pages have the same route", "expect": ["guide.troubleshooting"] },
    { "kind": "task", "query": "the site works on my machine but breaks after deploy", "expect": ["guide.troubleshooting", "guide.deployment-check"] },
    { "kind": "task", "query": "reorder pages in the sidebar", "expect": ["guide.navigation-lifecycle"] },
    { "kind": "task", "query": "make a help center in several languages", "expect": ["reference.config-examples", "guide.publications"] },
    { "kind": "task", "query": "add a filter box to a long table", "expect": ["guide.component.table"] },
    { "kind": "task", "query": "stop the tabs from changing height", "expect": ["guide.component.tabs"] },
    { "kind": "task", "query": "give one page a custom social image", "expect": ["guide.share-images"] },
    { "kind": "task", "query": "add my own page template for my team", "expect": ["guide.templates"] },
    { "kind": "task", "query": "only generate some of the API operations as pages", "expect": ["guide.api-generation"] },
    { "kind": "task", "query": "update the bundled skills after changing docs", "expect": ["guide.maintain-skills", "guide.agent-skills"] },
    { "kind": "task", "query": "serve the built site on my machine", "expect": ["reference.cli"] },
    { "kind": "task", "query": "host the site on my own Node server", "expect": ["guide.publish", "guide.host-adapters"] },
    { "kind": "task", "query": "find out what the project does not do yet", "expect": ["guide.status"] },
    { "kind": "task", "query": "the address my social preview images load from", "expect": ["guide.seo", "guide.share-images"] },

    { "kind": "synthesis", "query": "What can Shoalrun do?", "expectGroups": [["guide.what-is-shoalrun", "guide.about"], ["guide.status"]] },
    { "kind": "synthesis", "query": "How do document identity, navigation, and related reading work together?", "expectGroups": [["guide.concepts", "guide.content-identity"], ["guide.navigation-lifecycle"], ["guide.related-reading"]] },
    { "kind": "synthesis", "query": "How do versions and agent-readable output fit together?", "expectGroups": [["guide.publications"], ["guide.agent-friendliness", "guide.output"]] },
    { "kind": "synthesis", "query": "How can API examples and recipes help readers complete a goal?", "expectGroups": [["guide.api-generation", "guide.api-references"], ["guide.recipes-overview", "guide.recipe-drafts"]] },

    { "kind": "concept", "query": "what are stable IDs", "expect": ["guide.content-identity", "reference.glossary"] },
    { "kind": "concept", "query": "how does Shoalrun publish HTML and Markdown from source pages", "expect": ["guide.output", "guide.concepts"] },
    { "kind": "concept", "query": "what is a focused contract", "expect": ["guide.focused-contracts"] },
    { "kind": "concept", "query": "what is a publication channel", "expect": ["guide.publications", "guide.concepts", "reference.glossary"] },
    { "kind": "concept", "query": "what happens to a page marked draft", "expect": ["guide.concepts", "guide.troubleshooting", "guide.add-page"] },
    { "kind": "concept", "query": "what does a hosting adapter have to do", "expect": ["guide.host-adapters"] },
    { "kind": "concept", "query": "what is a snippet variable", "expect": ["guide.snippets"] },
    { "kind": "concept", "query": "how do agents get exact API details", "expect": ["guide.focused-contracts", "guide.agent-friendliness"] },

    { "kind": "paraphrase", "query": "expandable section that hides details until clicked", "expect": ["guide.component.collapsible"] },
    { "kind": "paraphrase", "query": "numbered steps that highlight code as you scroll", "expect": ["guide.component.walkthrough"] },
    { "kind": "paraphrase", "query": "flowcharts and sequence diagrams from text", "expect": ["guide.component.diagrams"] },
    { "kind": "paraphrase", "query": "highlight a warning or tip in the page", "expect": ["guide.component.callout"] },
    { "kind": "paraphrase", "query": "order and grouping of the sidebar", "expect": ["guide.navigation-lifecycle"] },
    { "kind": "paraphrase", "query": "links in the top bar of every page", "expect": ["guide.header"] },
    { "kind": "paraphrase", "query": "make an endpoint show a Beta badge", "expect": ["guide.navigation-lifecycle", "reference.openapi-extension-mappings", "guide.frontmatter"] },
    { "kind": "paraphrase", "query": "which OpenAPI keywords can't be used", "expect": ["guide.openapi-support"] },
    { "kind": "paraphrase", "query": "list of color and spacing variables I can override", "expect": ["guide.css"] },
    { "kind": "paraphrase", "query": "check that my brand colors are readable", "expect": ["guide.palettes"] },
    { "kind": "paraphrase", "query": "let readers hide sections that don't apply to them", "expect": ["guide.reader-filters"] },

    { "kind": "typo", "query": "vercell deploymnet", "expect": ["guide.vercel"] },
    { "kind": "typo", "query": "configration presets", "expect": ["guide.configuration", "reference.config"] },
    { "kind": "typo", "query": "diagrm mermad", "expect": ["guide.component.diagrams"] },
    { "kind": "typo", "query": "colour palete contrast", "expect": ["guide.palettes"] },
    { "kind": "typo", "query": "deploymnet check", "expect": ["guide.deployment-check"] },
    { "kind": "typo", "query": "frontmater reference", "expect": ["guide.frontmatter-reference", "guide.frontmatter"] },
    { "kind": "typo", "query": "shoalrun serch command", "expect": ["reference.cli", "guide.search"] },

    { "kind": "none", "query": "configure Kubernetes autoscaling", "expect": [] },
    { "kind": "none", "query": "reset my account password", "expect": [] },
    { "kind": "none", "query": "how do I train a machine learning model", "expect": [] },
    { "kind": "none", "query": "does Shoalrun support GraphQL APIs", "expect": [] },
    { "kind": "none", "query": "add Google Analytics to every page", "expect": [] },
    { "kind": "none", "query": "migrate from Docusaurus", "expect": [] },
    { "kind": "none", "query": "export the documentation as a PDF", "expect": [] },
    { "kind": "none", "query": "run Shoalrun inside a Docker container", "expect": [] },
    { "kind": "none", "query": "add an edit this page link to every page", "expect": [] },
    { "kind": "none", "query": "how much does Shoalrun cost", "expect": [] },
    { "kind": "none", "query": "add reader comments to pages", "expect": [] }
  ]
}
