{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoalrun.com/schemas/content-export.schema.json",
  "title": "Shoalrun portable content export, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "digest", "publicBase", "publication", "review", "documents", "assets", "files", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "shoalrun-content-export" },
    "digest": { "$ref": "#/$defs/digest" },
    "publicBase": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_~.-]+/)*$" },
    "publication": { "$ref": "#/$defs/publication" },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status", "apis"],
      "properties": {
        "status": { "enum": ["ok", "required"] },
        "apis": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["apiId", "digest"], "properties": { "apiId": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } } } }
      }
    },
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "publication", "title", "summary", "type", "representations", "assets", "externalDependencies"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "publication": { "$ref": "#/$defs/publication" },
          "title": { "type": "string" }, "summary": { "type": "string" }, "type": { "type": "string" },
          "canonicalUrl": { "type": "string", "format": "uri" },
          "representations": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "html": { "$ref": "#/$defs/representation" }, "markdown": { "$ref": "#/$defs/representation" } } },
          "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "externalDependencies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["url", "kind"], "properties": { "url": { "type": "string", "format": "uri" }, "kind": { "const": "image" } } } }
        }
      }
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "diagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "documentId", "message"], "properties": { "code": { "type": "string" }, "documentId": { "type": "string" }, "message": { "type": "string" } } } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?:content/|assets/|NOTICES\\.txt$)[A-Za-z0-9_./-]*$" },
    "publication": { "type": "object", "additionalProperties": false, "required": ["channel", "version", "language"], "properties": { "channel": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "language": { "type": "string", "minLength": 1 } } },
    "file": { "type": "object", "required": ["path", "bytes", "digest"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0 }, "digest": { "$ref": "#/$defs/digest" } } },
    "asset": { "allOf": [{ "$ref": "#/$defs/file" }], "type": "object", "required": ["mediaType"], "properties": { "mediaType": { "type": "string" } } },
    "representation": {
      "allOf": [{ "$ref": "#/$defs/asset" }],
      "type": "object", "required": ["anchors", "links"],
      "properties": {
        "anchors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "exportedId"], "properties": { "id": { "type": "string" }, "exportedId": { "type": "string" }, "title": { "type": "string" } } } },
        "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["key", "kind", "href"], "properties": { "key": { "type": "string" }, "kind": { "enum": ["document", "canonical", "external", "asset"] }, "href": { "type": "string" }, "documentId": { "type": "string" }, "fragment": { "type": "string" }, "query": { "type": "string" }, "asset": { "$ref": "#/$defs/path" } } } }
      }
    }
  }
}
