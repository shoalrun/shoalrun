{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "shoalrun-code-reference"
    },
    "programmingLanguage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "extractorVersion": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "symbols": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\x00-\\x1f]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "enum": [
              "module",
              "namespace",
              "class",
              "interface",
              "enum",
              "type",
              "function",
              "method",
              "constructor",
              "property",
              "attribute",
              "constant"
            ]
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\x00-\\x1f]+$"
          },
          "visibility": {
            "default": "public",
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "description": {
            "type": "string",
            "maxLength": 100000
          },
          "annotation": {
            "type": "string",
            "maxLength": 100000
          },
          "default": {
            "type": "string",
            "maxLength": 100000
          },
          "required": {
            "type": "boolean"
          },
          "bases": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "constructorSignature": {
            "type": "string",
            "maxLength": 100000
          },
          "typeReferences": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1f]+$"
            }
          },
          "signatures": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "parameters": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "type": {
                  "type": "string",
                  "maxLength": 100000
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                },
                "default": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "returns": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 100000
              },
              "description": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "additionalProperties": false
          },
          "yields": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 100000
              },
              "description": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "additionalProperties": false
          },
          "raises": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "type": {
                  "type": "string",
                  "maxLength": 100000
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                },
                "default": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "examples": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 512
                },
                "code": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "code"
              ],
              "additionalProperties": false
            }
          },
          "seeAlso": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1f]+$"
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[^/\\\\\\x00:]+(?:\\/[^/\\\\\\x00:]+)*$"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "visibility"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "programmingLanguage",
    "producer",
    "symbols"
  ],
  "additionalProperties": false,
  "title": "Shoalrun Code API reference snapshot"
}
